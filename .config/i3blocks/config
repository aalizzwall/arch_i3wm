# 全域設定：每 5 秒更新一次，並設定顏色
separator_block_width=15
markup=none

[net_all_in_one]
command=~/.config/i3blocks/scripts/net_all_in_one
interval=2
markup=pango
cursor=pointer

[bluetooth]
command=~/.config/i3blocks/scripts/bluetooth.sh
interval=5
markup=pango

[crypto_bot-service]
# 指向你剛剛建立的腳本
command=~/.config/i3blocks/scripts/systemd_user_status.sh
# 填入你 podman 服務的確切名稱 (例如 container-my-app.service)
instance=crypto_bot.service
# 每 10 秒檢查一次狀態
interval=10
# 讓游標移過去時顯示為手指圖示 (代表可點擊)
cursor=pointer

# 1. PSI + Load Average 卡頓雷達（點擊看 PSI 與 Top CPU）
[system_load]
command=~/.config/i3blocks/scripts/psi_load.sh
interval=2
cursor=pointer

# 2. CPU 使用率 + 即時頻率（零依賴純 /proc/stat，點擊看 Governor/ASPM/Undervolt）
[cpu_usage]
command=~/.config/i3blocks/scripts/cpu_freq.sh
interval=3
cursor=pointer

# 3. 真實 CPU 封裝溫度 + Intel GPU 頻率 + Apple 風扇轉速（跨機自動偵測）
[temperature]
command=~/.config/i3blocks/scripts/temp_fan.sh
interval=3
cursor=pointer

# 4. 真實可用記憶體 (MemAvailable，點擊看 Dirty/Shmem 與 Top 5 RAM)
[memory]
command=~/.config/i3blocks/scripts/memory_geek.sh
interval=5
cursor=pointer

# 5. zram 壓縮 + Brave RAM OverlayFS（條件顯示，平常極精簡）
[zram_psd]
command=~/.config/i3blocks/scripts/zram_psd.sh
interval=10
cursor=pointer

# 6. 硬體空間 - 隨時監控你的 SSD 還有多少容量
[disk]
command=~/.config/i3blocks/contrib/disk/disk
label=󰋊 
interval=30
instance=/

# 7. 音量顯示
[volume]
command=wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2*100) "%" ($3=="[MUTED]" ? " 󰝟" : " ")}'
label=VOL 
interval=once
signal=10
color=#f3f4f5

# 8. 電池電量 + 即時放電/充電瓦數（點擊顯示預估時間、健康度、循環次數）
[battery]
command=~/.config/i3blocks/scripts/battery_watt.sh
interval=5
cursor=pointer

# 9. 時間與日期
[time]
command=date '+%Y-%m-%d %H:%M:%S'
interval=1
