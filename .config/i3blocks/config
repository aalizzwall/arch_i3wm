# i3blocks 結構化儀表板設定 (Nord 底線分群 + 純 Nerd Font + 條件展開)
# 全域預設：Pango 雙色渲染、關閉預設分隔線、底部 2px 群組色條
markup=pango
separator=false
separator_block_width=8
border_top=0
border_bottom=2
border_left=0
border_right=0

# ==============================================================================
# 群組 1：連線與服務 (Nord Frost Cyan #88c0d0)
# ==============================================================================
[net_all_in_one]
command=~/.config/i3blocks/scripts/net_all_in_one
interval=2
cursor=pointer
border=#88c0d0

[crypto_bot-service]
command=~/.config/i3blocks/scripts/systemd_user_status.sh
instance=crypto_bot.service
interval=10
cursor=pointer
border=#88c0d0

[bluetooth]
command=~/.config/i3blocks/scripts/bluetooth.sh
interval=5
cursor=pointer
border=#88c0d0
separator_block_width=20

# ==============================================================================
# 群組 2：運算與散熱 (Nord Aurora Orange #d08770)
# ==============================================================================
[system_load]
command=~/.config/i3blocks/scripts/psi_load.sh
interval=2
cursor=pointer
border=#d08770

[cpu_usage]
command=~/.config/i3blocks/scripts/cpu_freq.sh
interval=3
cursor=pointer
border=#d08770

[temperature]
command=~/.config/i3blocks/scripts/temp_fan.sh
interval=3
cursor=pointer
border=#d08770
separator_block_width=20

# ==============================================================================
# 群組 3：記憶體與儲存 (Nord Aurora Purple #b48ead)
# ==============================================================================
[memory]
command=~/.config/i3blocks/scripts/memory_geek.sh
interval=5
cursor=pointer
border=#b48ead

[zram_psd]
command=~/.config/i3blocks/scripts/zram_psd.sh
interval=10
cursor=pointer
border=#b48ead

[disk]
command=~/.config/i3blocks/scripts/disk_usage.sh
instance=/
interval=30
cursor=pointer
border=#b48ead
separator_block_width=20

# ==============================================================================
# 群組 4：裝置與時間 (Nord Aurora Green #a3be8c)
# ==============================================================================
[volume]
command=~/.config/i3blocks/scripts/volume.sh
interval=once
signal=10
cursor=pointer
border=#a3be8c

[battery]
command=~/.config/i3blocks/scripts/battery_watt.sh
interval=5
cursor=pointer
border=#a3be8c

[time]
command=~/.config/i3blocks/scripts/clock.sh
interval=10
cursor=pointer
border=#a3be8c
